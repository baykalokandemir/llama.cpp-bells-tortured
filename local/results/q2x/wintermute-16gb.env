# wintermute: 2x RTX 5060 Ti 16 GB (sm_120, no SM-level P2P), 112 GiB RAM, PLE meant to live in swap.
# Derived from fast-256k.env; changes: 64k context, KV sized for it, smaller hot cache, no P2P all-reduce,
# no PLE prefault (so the table can be paged out), expandable segments on for the tight VRAM.
PORT=8210
MAX_MODEL_LEN=65536
KV_CACHE_MEMORY_BYTES=1560281088
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=40
DISABLE_CUSTOM_ALL_REDUCE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
QWEN38_PLE_PREFAULT=0
QWEN38_STREAM_STAGE=0
QWEN38_STREAM_STAGE_MIN_TOKENS=1536
QWEN38_STAGE_OVERLAP=0
QWEN38_ASYNC_SCHEDULING=1
VLLM_MTP_DRAFT_VOCAB_RANGES=[[0,65536],[248044,248320]]
JIT_CACHE_DIR=./jit-cache
